{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StoreDocumentRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document_id",
    "version",
    "filename",
    "content_base64",
    "sha256"
  ],
  "properties": {
    "document_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9]+$",
      "minLength": 1,
      "maxLength": 128
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "filename": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "content_base64": {
      "type": "string",
      "minLength": 1,
      "contentEncoding": "base64"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
